---
import { art } from '../lib/art.js';
import { BADGES } from '../../lib/taxonomy.mjs';
const { a, feature = false } = Astro.props;
---
<a class:list={['card', { feature }]} href={a.url} data-reveal>
  <div class="card-art" set:html={art(a.id, a.zone)}></div>
  <div class="card-body">
    <div class="meta">
      <span class={`badge b-${a.badge.toLowerCase()}`} title={BADGES[a.badge].hint}>{BADGES[a.badge].label}</span>
      <span class="cat">{a.categoryShort}</span>
      <span class="mins">{a.minutes} min</span>
    </div>
    <h3>{a.title}</h3>
    <p>{a.dek}</p>
  </div>
</a>
