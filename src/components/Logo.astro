---
// Emblema inspirado no pôster da marca: globo noturno com órbita passando pela frente.
---
<span class="logo">
  <svg class="logo-mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="logo-orbit" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#ff8a2b" /><stop offset=".55" stop-color="#f4f6f9" /><stop offset="1" stop-color="#ffb066" /></linearGradient>
      <radialGradient id="logo-globe" cx=".62" cy=".3" r=".85"><stop offset="0" stop-color="#2f6ea3" /><stop offset=".55" stop-color="#0f2a47" /><stop offset="1" stop-color="#050b16" /></radialGradient>
    </defs>
    <circle cx="32" cy="32" r="20" fill="url(#logo-globe)" />
    <g fill="none" stroke="#8fc4ef" stroke-width=".8" opacity=".55">
      <ellipse cx="32" cy="32" rx="8" ry="20" /><ellipse cx="32" cy="32" rx="15" ry="20" />
      <path d="M12.5 26h39M12.5 38h39M12 32h40" />
    </g>
    <path d="M38 13a20 20 0 0 1 12 27" fill="none" stroke="#ff8a2b" stroke-width="2.2" stroke-linecap="round" />
    <path class="logo-orbit" d="M4 45C16 54 44 40 60 15" fill="none" stroke="url(#logo-orbit)" stroke-width="3" stroke-linecap="round" />
    <circle cx="60" cy="15" r="2.6" fill="#fff" />
  </svg>
  <span class="logo-word"><b>SYNC</b><i>NEWS</i></span>
</span>
