---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { href, latest } from '../lib/data.js';

const { title, description = 'Portal diário de IA, geopolítica, Brasil e mundo, com uma área separada para teorias e crenças.', zone = 'radar' } = Astro.props;
const isHome = Astro.url.pathname.replace(/\/$/, '') === href('/').replace(/\/$/, '');
const hasPush = Boolean(import.meta.env.PUBLIC_ONESIGNAL_APP_ID);
const fullTitle = title ? `${title} · Sync News` : 'Sync News';
const nav = [
  ['radar', 'Radar', ''],
  ['pilula', 'Pílula do Dia', ''],
  ['arcanum', 'Arcanum', 'veil-link'],
  ['edicoes', 'Edições', ''],
  ['fontes', 'Fontes', ''],
  ['sobre', 'Sobre', ''],
];
---
<!doctype html>
<html lang="pt-BR" data-zone={zone}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={zone === 'veu' ? '#e7d9bd' : '#070d18'} />
    <link rel="manifest" href={href('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={href('/icons/apple-touch-icon.png?v=2')} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Sync News" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(href('/brand/hero.jpg'), Astro.site).href} />
    <link rel="icon" type="image/png" sizes="32x32" href={href('/icons/favicon-32.png?v=2')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Cinzel:wght@500;700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Michroma&family=JetBrains+Mono:wght@500;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet" />
    <script is:inline>try{var f=JSON.parse(localStorage.getItem("sn-font"));if(f&&f!==100)document.documentElement.style.fontSize=f+"%"}catch(e){}</script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <div class="progress" data-progress aria-hidden="true"></div>
    <header class="top">
      <a class="brand" href={href('/')} aria-label="Sync News, página inicial"><Logo /></a>
      <div class="top-actions">
        <button class="bell" type="button" aria-label="Configurações" aria-expanded="false" aria-controls="painel-config" data-panel-toggle="settings"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10" /><circle cx="16" cy="7" r="2" /><circle cx="8" cy="17" r="2" /></svg></button>
        <button class="bell" type="button" aria-label="Notificações" aria-expanded="false" aria-controls="painel-notificacoes" data-panel-toggle="notifications"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 9a6 6 0 1 0-12 0c0 6-2.5 8-2.5 8h17S18 15 18 9" /><path d="M10.3 21a2 2 0 0 0 3.4 0" /></svg><span class="bell-count" data-center-count hidden></span></button>
        <button class="burger" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu" data-burger><span></span><span></span><span></span></button>
      </div>
      <nav id="menu" aria-label="Principal" data-menu>
        {nav.map(([id, label, cls]) => <a href={isHome ? `#${id}` : href(`/#${id}`)} class={cls} data-nav={id}>{label}</a>)}
      </nav>
      <section class="panel" id="painel-notificacoes" data-panel="notifications" aria-label="Central de notificações" hidden>
        <header class="panel-head">
          <h2>Notificações</h2>
          <div class="panel-actions">
            <button type="button" data-center-readall>Marcar todas como lidas</button>
            <button type="button" data-center-clear>Apagar tudo</button>
          </div>
        </header>
        <ul class="center-list" data-center-list></ul>
      </section>
      <section class="panel panel-settings" id="painel-config" data-panel="settings" aria-label="Configurações" hidden>
        <header class="panel-head"><h2>Configurações</h2></header>
        <div class="setting">
          <span>Tamanho do texto</span>
          <div class="stepper">
            <button type="button" data-font="dec" aria-label="Diminuir texto">A−</button>
            <output data-font-value>100%</output>
            <button type="button" data-font="inc" aria-label="Aumentar texto">A+</button>
          </div>
        </div>
        <button class="setting-reset" type="button" data-font="reset">Restaurar tamanho padrão</button>
        {hasPush && <div class="setting">
          <span>Notificações push<small>Aviso a cada edição nova</small></span>
          <button class="switch" type="button" role="switch" aria-checked="false" aria-label="Notificações push" data-push><span></span></button>
        </div>}
        <div class="setting">
          <span>Estatísticas de uso<small>Ajuda a saber o que é mais lido</small></span>
          <button class="switch" type="button" role="switch" aria-checked="true" aria-label="Estatísticas de uso" data-analytics><span></span></button>
        </div>
      </section>
    </header>
    <div class="stale" data-stale data-latest={latest?.date} hidden>
      Você está lendo a edição mais recente disponível. A próxima sai por volta das 08:00.
    </div>
    <main id="conteudo"><slot /></main>
    <footer class="foot">
      <div>
        <img class="foot-logo" src={href('/icons/icon-192.png')} alt="Sync News" width="148" height="148" loading="lazy" decoding="async" />
        <p>Textos assinados por Jack Parker, colunista gerado por inteligência artificial. Toda matéria aponta para as fontes originais.</p>
      </div>
      <div class="foot-links">
        <a href={href('/sobre')}>Como funciona</a>
        <a href={href('/fontes')}>Fontes</a>
        <a href={href('/edicoes')}>Arquivo</a>
      </div>
    </footer>
    <div class="toast" data-toast role="status" aria-live="polite"></div>
    <script src="../scripts/motion.js"></script>
    <script src="../scripts/push.js"></script>
    <script src="../scripts/center.js"></script>
    <script src="../scripts/analytics.js"></script>
  </body>
</html>
