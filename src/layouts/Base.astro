---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { href, latest } from '../lib/data.js';

const { title, description = 'Portal diário de IA, geopolítica, Brasil e mundo, com uma área separada para teorias e crenças.', zone = 'radar' } = Astro.props;
const isHome = Astro.url.pathname.replace(/\/$/, '') === href('/').replace(/\/$/, '');
const hasPush = Boolean(import.meta.env.PUBLIC_ONESIGNAL_APP_ID);
const fullTitle = title ? `${title} · Sync News` : 'Sync News';
const nav = [
  ['radar', 'Radar', ''],
  ['pilula', 'Pílula do Dia', ''],
  ['arcanum', 'Arcanum', 'veil-link'],
  ['edicoes', 'Edições', ''],
  ['fontes', 'Fontes', ''],
  ['sobre', 'Sobre', ''],
];
---
<!doctype html>
<html lang="pt-BR" data-zone={zone}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={zone === 'veu' ? '#e7d9bd' : '#070d18'} />
    <link rel="manifest" href={href('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={href('/icons/apple-touch-icon.png')} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Sync News" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(href('/brand/hero.jpg'), Astro.site).href} />
    <link rel="icon" type="image/svg+xml" href={href('/icon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={href('/icons/favicon-32.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Cinzel:wght@500;700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Michroma&family=JetBrains+Mono:wght@500;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet" />
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <div class="progress" data-progress aria-hidden="true"></div>
    <header class="top">
      <a class="brand" href={href('/')} aria-label="Sync News, página inicial"><Logo /></a>
      <div class="top-actions">
        {hasPush && <button class="bell" type="button" aria-label="Ativar notificações" aria-pressed="false" data-push><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 9a6 6 0 1 0-12 0c0 6-2.5 8-2.5 8h17S18 15 18 9" /><path d="M10.3 21a2 2 0 0 0 3.4 0" /></svg></button>}
  <button class="burger" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu" data-burger><span></span><span></span><span></span></button>
      </div>
      <nav id="menu" aria-label="Principal" data-menu>
        {nav.map(([id, label, cls]) => <a href={isHome ? `#${id}` : href(`/#${id}`)} class={cls} data-nav={id}>{label}</a>)}
      </nav>
    </header>
    <div class="stale" data-stale data-latest={latest?.date} hidden>
      Você está lendo a edição mais recente disponível. A próxima sai por volta das 08:00.
    </div>
    <main id="conteudo"><slot /></main>
    <footer class="foot">
      <div>
        <Logo />
        <p>Textos assinados por Jack Parker, colunista gerado por inteligência artificial. Toda matéria aponta para as fontes originais.</p>
      </div>
      <div class="foot-links">
        <a href={href('/sobre')}>Como funciona</a>
        <a href={href('/fontes')}>Fontes</a>
        <a href={href('/edicoes')}>Arquivo</a>
      </div>
    </footer>
    <div class="toast" data-toast role="status" aria-live="polite"></div>
    <script src="../scripts/motion.js"></script>
    <script src="../scripts/push.js"></script>
  </body>
</html>
