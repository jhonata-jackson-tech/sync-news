---
import Base from '../../../layouts/Base.astro';
import ArticleList from '../../../components/ArticleList.astro';
import { BADGES, ZONES } from '../../../../lib/taxonomy.mjs';
import { allArticles, prose, longDate, clock, href } from '../../../lib/data.js';
import { art } from '../../../lib/art.js';

export function getStaticPaths() {
  return allArticles.map((a) => ({ params: { zone: a.zoneSlug, id: a.id }, props: { a } }));
}
const { a } = Astro.props;
const z = ZONES[a.zone];
const belief = a.zone === 'veu';
const related = allArticles.filter((o) => o.zone === a.zone && o.id !== a.id && o.date === a.date).slice(0, 3);
---
<Base title={a.title} description={a.dek} zone={a.zone}>
  <article class="article" data-article>
    <figure class="article-figure">
      <div class="article-art">
        <Fragment set:html={art(a.id, a.zone)} />
        {a.photo && <img src={a.photo.image} alt="" referrerpolicy="no-referrer" onerror="this.closest('figure').querySelector('figcaption')?.remove(); this.remove()" />}
      </div>
      {a.photo && <figcaption>Imagem: reprodução de <a href={a.photo.url} rel="noopener" target="_blank">{a.photo.source}</a></figcaption>}
    </figure>
    {belief && <p class="veil-banner"><strong>Arcanum.</strong> Este texto apresenta teorias, previsões ou crenças ligadas a um fato atual. Não é notícia verificada.</p>}
    {a.anchorSource && <p class="anchor">Ponto de partida: <a href={a.anchorSource.url} rel="noopener" target="_blank">{a.anchorSource.source}: {a.anchorSource.title}</a></p>}
    <header class="article-head">
      <div class="meta">
        <span class={`badge b-${a.badge.toLowerCase()}`}>{BADGES[a.badge].label}</span>
        <a class="cat" href={href(`/${z.slug}/${a.category}`)}>{a.categoryName}</a>
        <span class="mins">{a.minutes} min de leitura</span>
      </div>
      <h1 data-split>{a.title}</h1>
      <p class="dek">{a.dek}</p>
      <p class="byline">Por <strong>Jack Parker (IA)</strong> · {longDate(a.date)}, {clock(a.publishedAt)}</p>
      {belief && a.attribution && <p class="attribution">Origem da tese: {a.attribution}</p>}
      {a.singleSource && <p class="attribution">Informação baseada em uma única fonte até o momento.</p>}
    </header>
    <div class="prose" set:html={prose(a.body)}></div>
    {a.quotes.map((q) => <blockquote class="quote"><p>{q.text}</p>{q.from && <cite>{q.from.source}</cite>}</blockquote>)}
    {a.counterpoint && (
      <aside class="counter">
        <h2>O que as fontes confirmam até agora</h2>
        <div set:html={prose(a.counterpoint.body)}></div>
        <ul>{a.counterSources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.source}: {s.title}</a></li>)}</ul>
      </aside>
    )}
    <section class="sources">
      <h2>Fontes</h2>
      <ul>{a.sourceList.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.source}: {s.title}</a></li>)}</ul>
    </section>
  </article>
  {related.length > 0 && <section class="wrap"><header class="section-head"><h2>Na mesma zona, hoje</h2></header><ArticleList items={related} /></section>}
</Base>
