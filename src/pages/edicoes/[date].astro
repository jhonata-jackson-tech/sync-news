---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import Pill from '../../components/Pill.astro';
import { editions, byZone, longDate, prose } from '../../lib/data.js';

export function getStaticPaths() {
  return editions.map((ed) => ({ params: { date: ed.date }, props: { ed } }));
}
const { ed } = Astro.props;
---
<Base title={`Edição de ${longDate(ed.date)}`} description={ed.overview.title}>
  <section class="zone-hero compact"><p class="eyebrow">{longDate(ed.date)}</p><h1 data-split>{ed.overview.title}</h1></section>
  <section class="wrap overview">
    <div class="overview-grid">
      <div class="lede" set:html={prose(ed.overview.body)}></div>
      <aside class="highlights"><h3>O que guardar deste dia</h3><ol>{ed.overview.highlights.map((h) => <li>{h}</li>)}</ol></aside>
    </div>
  </section>
  <section class="wrap"><header class="section-head"><h2>Radar</h2></header><ArticleList items={byZone(ed, 'radar')} /></section>
  <section class="wrap"><Pill pill={ed.pill} date={ed.date} /></section>
  <div class="z-veu veil-band"><section class="wrap"><header class="section-head"><h2>Arcanum</h2><p class="zone-note">Teorias e conexões, não notícias verificadas.</p></header><ArticleList items={byZone(ed, 'veu')} /></section></div>
</Base>
